<?xml version="1.0"?>
<configuration>
  <!--<runtime>
    <legacyCorruptedStateExceptionsPolicy enabled="true|false"/>
  </runtime>-->
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Ingenico.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <startup>
    
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup>
  <userSettings>
    <Ingenico.Properties.Settings>
      <setting name="TcpPort" serializeAs="String">
        <value>10000</value>
      </setting>
      <setting name="KeepAliveInterval" serializeAs="String">
        <value>-1</value>
      </setting>
      <setting name="FirstRun" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="ComPort" serializeAs="String">
        <value/>
      </setting>
      <setting name="ConnectionType" serializeAs="String">
        <value>2</value> <!--usb--> 
      </setting>
      <setting name="BaudRate" serializeAs="String">
        <value>9600</value>
      </setting>
      <setting name="DataBits" serializeAs="String">
        <value>8</value>
      </setting>
      <setting name="Parity" serializeAs="String">
        <value>None</value>
      </setting>
      <setting name="StopBits" serializeAs="String">
        <value>Two</value>
      </setting>
      <setting name="FlowControl" serializeAs="String">
        <value>RequestToSend</value>
      </setting>
      <setting name="AutoRepeatInterval" serializeAs="String">
        <value>2000</value>
      </setting>
      <setting name="TmCardKeys" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <string>00-00-00-00-00-00-00;00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00</string>
          </ArrayOfString>
        </value>
      </setting>
      <setting name="TmCardDetectionTimeout" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="TmDealerId" serializeAs="String">
        <value/>
      </setting>
      <setting name="TmKeyGenSecret" serializeAs="String">
        <value/>
      </setting>
      <setting name="TmKeyGenLength" serializeAs="String">
        <value>32</value>
      </setting>
      <setting name="ManagerPassword" serializeAs="String">
        <value>1234</value>
      </setting>
      <setting name="TransactionMode" serializeAs="String">
        <value>-1</value>
      </setting>
    </Ingenico.Properties.Settings>
  </userSettings>
</configuration>
