<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ChessPt.CashRegister.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
            <section name="CashRegisterTlv.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
    </startup>
    <userSettings>
        <ChessPt.CashRegister.Properties.Settings>
            <setting name="TcpPort" serializeAs="String">
                <value>10000</value>
            </setting>
            <setting name="KeepAliveInterval" serializeAs="String">
                <value>-1</value>
            </setting>
            <setting name="FirstRun" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ComPort" serializeAs="String">
                <value />
            </setting>
            <setting name="ConnectionType" serializeAs="String">
                <value>Tcp</value>
            </setting>
            <setting name="BaudRate" serializeAs="String">
                <value>115200</value>
            </setting>
            <setting name="DataBits" serializeAs="String">
                <value>8</value>
            </setting>
            <setting name="Parity" serializeAs="String">
                <value>None</value>
            </setting>
            <setting name="StopBits" serializeAs="String">
                <value>One</value>
            </setting>
            <setting name="FlowControl" serializeAs="String">
                <value>RequestToSend</value>
            </setting>
            <setting name="AutoRepeatInterval" serializeAs="String">
                <value>2000</value>
            </setting>
            <setting name="TmCardKeys" serializeAs="Xml">
                <value>
                    <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xmlns:xsd="http://www.w3.org/2001/XMLSchema">
                        <string>00-00-00-00-00-00-00;00-00-00-00-00-00-00-00-00-00-00-00-00-00-00-00</string>
                    </ArrayOfString>
                </value>
            </setting>
            <setting name="TmCardDetectionTimeout" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="TmDealerId" serializeAs="String">
                <value />
            </setting>
            <setting name="TmKeyGenSecret" serializeAs="String">
                <value />
            </setting>
            <setting name="TmKeyGenLength" serializeAs="String">
                <value>32</value>
            </setting>
            <setting name="ManagerPassword" serializeAs="String">
                <value>1234</value>
            </setting>
            <setting name="TransactionMode" serializeAs="String">
                <value>DeterminedByTerminal</value>
            </setting>
            <setting name="DoNotDisableButtons" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="TmPresentCardText" serializeAs="String">
                <value>PRESENT CARD</value>
            </setting>
            <setting name="TmPresentCardBeep" serializeAs="String">
                <value>Attention</value>
            </setting>
            <setting name="TmPresentCardLeds" serializeAs="String">
                <value>Led1</value>
            </setting>
            <setting name="TmEndText" serializeAs="String">
                <value>REMOVE CARD</value>
            </setting>
            <setting name="TmEndBeep" serializeAs="String">
                <value>Success</value>
            </setting>
            <setting name="TmEndLeds" serializeAs="String">
                <value>None</value>
            </setting>
            <setting name="TmCardDetectedText" serializeAs="String">
                <value>Processing
Please Wait...</value>
            </setting>
            <setting name="TmCardDetectedBeep" serializeAs="String">
                <value>Attention</value>
            </setting>
            <setting name="TmCardDetectedLeds" serializeAs="String">
                <value>All</value>
            </setting>
            <setting name="SaveTicketPath" serializeAs="String">
                <value />
            </setting>
        </ChessPt.CashRegister.Properties.Settings>
        <CashRegisterTlv.Properties.Settings>
            <setting name="TcpPort" serializeAs="String">
                <value>2000</value>
            </setting>
            <setting name="KeepAliveInterval" serializeAs="String">
                <value>-1</value>
            </setting>
            <setting name="FirstRun" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ComPort" serializeAs="String">
                <value />
            </setting>
            <setting name="ConnectionType" serializeAs="String">
                <value>0</value>
            </setting>
        </CashRegisterTlv.Properties.Settings>
    </userSettings>
</configuration>
