fasopen(name,mode)
char *name;
int16 mode;
{
  int16 i;

  pi = (int16 *) info;
  *pi = mode;
  i = 2;
  FOREVER {
    info[i++] = *name;
    if (!*name) break;
    name++;
  }
  EDBsendtask(FASMNGR,6,1,info,i);
  return fas_ret(info+2);  /* if bytes returned, copy them on themselves */
}

