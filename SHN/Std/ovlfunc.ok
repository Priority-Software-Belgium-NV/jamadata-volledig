  _sleep(1000);
};

void sendtask(short int destprc,short int type,short int function,char *info,short int len)
{
	int16 *pi;

	if (type==3 && function==11) {
	  pi=(int16 *)info;
		scraddf(pi[0],pi[1],pi[2],pi[3]);
	}
	if (type==6) EDBsendtask(destprc,type,function,info,len);
}

