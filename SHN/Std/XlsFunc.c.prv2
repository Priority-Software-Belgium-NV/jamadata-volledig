static int XlsSelectWorkSheet(ref,WksNr,WksName) // WknNr = 1, 2, ... WksCount
int16 ref, WksNr;
char *WksName;
{
  int16 i;
 
  pi = (int16 *) info;
  *pi++ = 8;
  *pi++ = ref;
  *pi++ = WksNr;

  i=6;
  if (WksName==0) WksName="";
  FOREVER {
    info[i++] = *WksName;
    if (!*WksName) break;
    WksName++;
  }
  sendtask(FASMNGR,6,202,info,i);
  return fas_ret(info+2);
}

static int XlsChart(ref,rowcnt,colcnt,chartType,title)
int16 ref, rowcnt, colcnt, chartType;
char *title;
{
  int16 i;
 
  pi = (int16 *) info;
  *pi++ = 5;
  *pi++ = ref;
  *pi++ = rowcnt;
  *pi++ = colcnt;
  *pi++ = chartType;
  i=10;

   FOREVER {
    info[i++] = *title;
    if (!*title) break;
    title++;
  }
  sendtask(FASMNGR,6,202,info,i);
  return fas_ret(info+2);
}
 
static int XlsGraf(ref,colnr,chartType,Color)
int16 ref, colnr, chartType;
long Color;
{
  int16 i;
  long *pl;
 
  pi = (int16 *) info;
  *pi++ = 6;
  *pi++ = ref;
  *pi++ = colnr;
  *pi++ = chartType;
  pl=(long *)pi;
  *pl++ = Color;
  pi=(int16 *)pl;

  i=12;

  sendtask(FASMNGR,6,202,info,i);
  return fas_ret(info+2);
}

